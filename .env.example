# === APIx Configuration ===
# Real-Time Airfare Price Index Platform (MoSPI / NSO CPI Infrastructure)

# Server
ENV=development
PORT=8000

# Authentication
API_KEYS=your-api-key-here
AUTH_DISABLED=false
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM Providers & Search APIs
GEMINI_API_KEY=your-gemini-api-key
SERPAPI_KEY=your-serpapi-key

# Database
DATABASE_URL=sqlite+aiosqlite:///data/apix.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Demo Mode (offline, resilient live demos using seeded 30-day airfare dataset)
DEMO_MODE=true

# Index & Methodology
SCRAPE_SCHEDULE_CRON=0 6 * * *
INDEX_BASE_DATE=2026-08-01
DEFAULT_CABIN_CLASS=economy

# Deployment (for hosted demo)
CORS_ORIGINS=http://localhost:8000
CSP_CONNECT_SRC=

# Playwright Browser Pool
MAX_PLAYWRIGHT_INSTANCES=3

# Sessions
SESSION_TTL_MINUTES=30
MAX_SESSIONS=100
